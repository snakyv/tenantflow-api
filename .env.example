APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+asyncpg://tenantflow:tenantflow@localhost:55432/tenantflow
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=tenantflow-api
JWT_AUDIENCE=tenantflow-api
WEBHOOK_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=tenantflow
MINIO_SECRET_KEY=tenantflow-secret
MINIO_BUCKET=tenantflow
MINIO_REGION=us-east-1
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@tenantflow.local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
